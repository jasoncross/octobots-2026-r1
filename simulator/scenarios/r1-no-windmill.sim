# Robot 1 with NO windmill in the robot configuration (its feeder is optional() in Robot.java): INIT
# goes on with a note, the flywheel still spins, the intake picks up, and RB fires nothing (no feeder:
# on the real robot the intake pushes pieces up the scoop into the wheel).
# Run it: the "Simulator tests" button in Android Studio (all tests), or from the ftc-helper-lib folder:
#   ./gradlew :sim:scenario -Pfile=../simulator/scenarios/r1-no-windmill.sim
robot ../robot.properties
set device windmill missing            # not in the configuration (from this INIT)
init "R1 TeleOp"
expect error none                      # no "No CRServo named windmill" at INIT
expect screen has "not in the configuration"   # INIT says the feeder is off
start
expect within 4 motor launcher velocity > 1000   # the flywheel spins from START
expect within 1 motor intake power > 0.9          # the intake runs
press g1.right_bumper                  # RB: fire: no feeder, so nothing is fed
wait 1
expect launched = 0
stop
expect error none
